# Nusxa oling: .env.local  (git ga kirmaydi)

# Sessiya cookie imzosi uchun uzun tasodifiy qator (kamida 32 belgi).
# Yaratish:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Birinchi ishga tushishda shu admin yaratiladi (faqat admin jadvali bo'sh bo'lsa).
ADMIN_EMAIL=admin@ustatop.uz
ADMIN_PASSWORD=

# Ixtiyoriy: SQLite fayli joylashadigan papka (standart: ./data)
# DATABASE_DIR=
